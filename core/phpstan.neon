includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    parallel:
        maximumNumberOfProcesses: 1
    level: 5
    paths:
        - app
        - routes
    tmpDir: storage/framework/phpstan
    treatPhpDocTypesAsCertain: false
    squashedMigrationsPath:
        - phpstan-schema
