{
	admin off
	email {$ACME_CONTACT_EMAIL}
}

https://{$TELEMETRY_HOSTNAME}:8444 {
	@edge_sources remote_ip {$EDGE_PUBLIC_IPV4_ALLOWLIST}
	@log_sources {
		path /loki/api/v1/push
		remote_ip {$EDGE_PUBLIC_IPV4_ALLOWLIST} {$LOG_SOURCE_IPV4_ALLOWLIST}
	}

	handle @log_sources {
		reverse_proxy loki:3100
	}

	handle @edge_sources {
		reverse_proxy clickhouse:8123
	}

	respond 403
}

http://127.0.0.1:2019 {
	respond /healthz 200
}
