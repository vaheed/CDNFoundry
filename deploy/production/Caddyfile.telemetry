{
	admin off
	email {$ACME_CONTACT_EMAIL}
}

https://{$TELEMETRY_HOSTNAME}:8444 {
	import /etc/caddy/own-tls/telemetry-*.caddy
	@clickhouse_sources remote_ip {$EDGE_PUBLIC_IPV4_ALLOWLIST} {$EDGE_PUBLIC_IPV6_ALLOWLIST} {$CONTROL_PUBLIC_IPV4_ALLOWLIST} {$CONTROL_PUBLIC_IPV6_ALLOWLIST}
	@log_sources {
		path /loki/api/v1/push
		remote_ip {$EDGE_PUBLIC_IPV4_ALLOWLIST} {$EDGE_PUBLIC_IPV6_ALLOWLIST} {$LOG_SOURCE_IPV4_ALLOWLIST} {$LOG_SOURCE_IPV6_ALLOWLIST}
		header Authorization "Bearer {$LOG_AUTH_TOKEN}"
	}

	handle @log_sources {
		reverse_proxy loki:3100
	}

	handle @clickhouse_sources {
		reverse_proxy clickhouse:8123
	}

	respond 403
}

# Grafana has no public path at all, not even its health and metrics endpoints. An empty
# MANAGEMENT_NETWORKS renders as "0.0.0.0/0 ::/0" in Compose, which restricts nothing.
(management_only_strict) {
	@outside not remote_ip {$MANAGEMENT_NETWORKS}
	handle @outside {
		header Cache-Control "no-store"
		respond "Forbidden" 403
	}
}

{$GRAFANA_HOSTNAME} {
	import /etc/caddy/own-tls/grafana-*.caddy
	import management_only_strict
	reverse_proxy grafana:3000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}
}

http://127.0.0.1:2019 {
	respond /healthz 200
}
