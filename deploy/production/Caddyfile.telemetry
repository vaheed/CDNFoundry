{
	admin off
	email {$ACME_CONTACT_EMAIL}
}

https://{$TELEMETRY_HOSTNAME}:8444 {
	import /etc/caddy/own-tls/telemetry-*.caddy
	@clickhouse_sources {
		import /etc/caddy/allowlists/clickhouse-sources.caddy
	}
	@log_sources {
		path /loki/api/v1/push
		import /etc/caddy/allowlists/telemetry-log-sources.caddy
		header Authorization "Bearer {$LOG_AUTH_TOKEN}"
	}

	handle @log_sources {
		reverse_proxy loki:3100
	}

	handle @clickhouse_sources {
		reverse_proxy clickhouse:8123
	}

	respond 403
}

# Grafana has no public path at all, not even its health and metrics endpoints. An empty
# The address lists live in files under /etc/caddy/allowlists (Fleet writes them) and are read again on a reload
# (SIGUSR1). An empty management list is "0.0.0.0/0 ::/0", which restricts nothing.
(management_only_strict) {
	@outside {
		not {
			import /etc/caddy/allowlists/management-networks.caddy
		}
	}
	handle @outside {
		header Cache-Control "no-store"
		respond "Forbidden" 403
	}
}

{$GRAFANA_HOSTNAME} {
	import /etc/caddy/own-tls/grafana-*.caddy
	import management_only_strict
	reverse_proxy grafana:3000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}
}

http://127.0.0.1:2019 {
	respond /healthz 200
}
