{
	admin off
	email {$ACME_CONTACT_EMAIL}
}

{$CONTROL_HOSTNAME} {
	# A two-node control plane serves an operator-supplied certificate (the standby cannot obtain one while
	# idle). Without the HA bundle this directory does not exist and Caddy issues its own.
	import /etc/caddy/tls.d/*.caddy
	# An operator-supplied certificate (Fleet web or `management-tls`) replaces automatic issuance for this name.
	import /etc/caddy/own-tls/control-*.caddy

	encode zstd gzip
	reverse_proxy web:8080 {
		# Replace caller-supplied forwarding chains at the public trust boundary.
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Port 443
		header_up X-Forwarded-Host {$CONTROL_HOSTNAME}
		header_down Location "http://{$CONTROL_HOSTNAME}" "https://{$CONTROL_HOSTNAME}"
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "upgrade-insecure-requests"
		-Server
	}
}

https://{$TELEMETRY_HOSTNAME}:8444 {
	import /etc/caddy/own-tls/telemetry-*.caddy
	@log_sources {
		remote_ip {$LOG_SOURCE_IPV4_ALLOWLIST} {$LOG_SOURCE_IPV6_ALLOWLIST}
		path /loki/api/v1/push
		header Authorization "Bearer {$LOG_AUTH_TOKEN}"
	}

	handle @log_sources {
		reverse_proxy loki:3100
	}

	@clickhouse_sources remote_ip {$EDGE_PUBLIC_IPV4_ALLOWLIST} {$EDGE_PUBLIC_IPV6_ALLOWLIST} {$CONTROL_PUBLIC_IPV4_ALLOWLIST} {$CONTROL_PUBLIC_IPV6_ALLOWLIST}

	handle @clickhouse_sources {
		reverse_proxy clickhouse:8123
	}

	respond 403
}

{$GRAFANA_HOSTNAME} {
	import /etc/caddy/own-tls/grafana-*.caddy
	reverse_proxy grafana:3000
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
}

http://127.0.0.1:2019 {
	respond /healthz 200
}
