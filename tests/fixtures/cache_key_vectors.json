{
  "description": "Cache key vectors shared by the PHP purge implementation and the Lua cell runtime. 'target' is the raw request target; 'expected' is the canonical target, or null when the target has no key (the reason is checked by both suites).",
  "vectors": [
    {"name": "root", "target": "/", "expected": "/"},
    {"name": "plain path", "target": "/a/b.css", "expected": "/a/b.css"},
    {"name": "trailing slash kept", "target": "/a/", "expected": "/a/"},
    {"name": "escape hex is uppercased", "target": "/a%2fb", "expected": "/a%2Fb"},
    {"name": "encoded slash stays encoded", "target": "/x%2Fy", "expected": "/x%2Fy"},
    {"name": "encoded question mark stays in the path", "target": "/x%3Fv=1", "expected": "/x%3Fv=1"},
    {"name": "encoded question mark differs from a query", "target": "/x?v=1", "expected": "/x?v=1"},
    {"name": "unreserved escapes are decoded", "target": "/%41%7e%2d", "expected": "/A~-"},
    {"name": "space stays encoded in the path", "target": "/a%20b", "expected": "/a%20b"},
    {"name": "plus in the path is literal", "target": "/a+b", "expected": "/a+b"},
    {"name": "plus in the query is a space", "target": "/?q=a+b", "expected": "/?q=a%20b"},
    {"name": "encoded plus in the query stays a plus", "target": "/?q=a%2Bb", "expected": "/?q=a%2Bb"},
    {"name": "query is sorted by name then value as strings", "target": "/?b=2&a=10&a=9&a=2", "expected": "/?a=10&a=2&a=9&b=2"},
    {"name": "empty pairs are skipped", "target": "/?&a=1&&b=2&", "expected": "/?a=1&b=2"},
    {"name": "bare name equals empty value", "target": "/?a&b=", "expected": "/?a=&b="},
    {"name": "value may contain equals", "target": "/?a=b=c", "expected": "/?a=b%3Dc"},
    {"name": "query encoding is canonical", "target": "/?a=%7e%c3%a9", "expected": "/?a=~%C3%A9"},
    {"name": "dot segment", "target": "/a/../b", "expected": null, "reason": "dot_segment"},
    {"name": "single dot segment", "target": "/a/./b", "expected": null, "reason": "dot_segment"},
    {"name": "encoded dot segment", "target": "/a/%2e%2E/b", "expected": null, "reason": "dot_segment"},
    {"name": "double slash", "target": "//a", "expected": null, "reason": "empty_segment"},
    {"name": "inner double slash", "target": "/a//b", "expected": null, "reason": "empty_segment"},
    {"name": "malformed escape in the path", "target": "/a%zz", "expected": null, "reason": "invalid_percent_encoding"},
    {"name": "truncated escape in the path", "target": "/a%2", "expected": null, "reason": "invalid_percent_encoding"},
    {"name": "malformed escape in the query", "target": "/?a=%zz", "expected": null, "reason": "invalid_percent_encoding"},
    {"name": "raw space in the path", "target": "/a b", "expected": null, "reason": "invalid_path_character"},
    {"name": "raw non-ascii in the path", "target": "/é", "expected": null, "reason": "invalid_path_character"},
    {"name": "absolute form is not a key", "target": "http://x/a", "expected": null, "reason": "not_origin_form"},
    {"name": "ignore_all drops the query", "target": "/a?x=1&y=2", "policy": "ignore_all", "expected": "/a"},
    {"name": "include_selected keeps only listed names", "target": "/a?x=1&y=2&z=3", "policy": "include_selected", "parameters": ["y", "z"], "expected": "/a?y=2&z=3"},
    {"name": "ignore_selected drops listed names", "target": "/a?x=1&y=2&z=3", "policy": "ignore_selected", "parameters": ["y"], "expected": "/a?x=1&z=3"},
    {"name": "selection matches the decoded name", "target": "/a?%78=1&y=2", "policy": "include_selected", "parameters": ["x"], "expected": "/a?x=1"},
    {"name": "128 arguments are accepted", "target_repeat": {"prefix": "/?", "item": "a=1", "separator": "&", "count": 128}, "policy": "ignore_all", "expected": "/"},
    {"name": "129 arguments have no key even when ignored", "target_repeat": {"prefix": "/?", "item": "a=1", "separator": "&", "count": 129}, "policy": "ignore_all", "expected": null, "reason": "too_many_query_arguments"}
  ]
}
