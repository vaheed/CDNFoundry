   "headers": {
    "User-Agent": "CDNFoundry-WAF-Baseline/1.0"
   }
  },
  {
   "id": "evasion:traversal-double-encoded",
   "class": "encoding",
   "note": "Path traversal with a double-encoded dot",
   "path": "/?file=%252e%252e/%252e%252e/etc/passwd",
