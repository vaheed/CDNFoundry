   "note": "Classic tautology in the query",
   "expect": {
    "balanced": "block",
    "strict": "block"
   },
   "path": "/?id=1%27%20OR%20%271%27%3D%271",
   "headers": {
    "User-Agent": "CDNFoundry-WAF-Baseline/1.0"
   }
  },
  {
   "id": "evasion:sqli-union-query",
   "class": "control",
   "note": "UNION SELECT in the query",
   "expect": {
    "balanced": "block",
    "strict": "block"
   },
   "path": "/?id=1%20UNION%20SELECT%20username,password%20FROM%20users",
   "headers": {
    "User-Agent": "CDNFoundry-WAF-Baseline/1.0"
   }
  },
  {
   "id": "evasion:sqli-json-body",
   "class": "control",
   "note": "SQL injection in a JSON field",
   "expect": {
    "balanced": "block",
