{
 "version": "evasions-1",
 "description": "CDNFoundry evasion cases for the managed WAF baseline. Synthetic payloads only.",
 "cases": [
  {
   "id": "evasion:xss-query",
   "class": "framing",
   "note": "XSS payload in the query string",
   "expect": {
    "balanced": "block",
    "strict": "block"
   },
   "path": "/?q=%3Cscript%3Ealert(1)%3C/script%3E",
   "headers": {
    "User-Agent": "CDNFoundry-WAF-Baseline/1.0"
   }
  },
  {
   "id": "evasion:xss-content-length",
   "class": "framing",
   "note": "XSS in a POST with Content-Length",
   "expect": {
    "balanced": "block",
    "strict": "block"
   },
   "method": "POST",
   "headers": {
    "Content-Type": "application/x-www-form-urlencoded",
    "User-Agent": "CDNFoundry-WAF-Baseline/1.0"
   },
   "body": "q=%3Cscript%3Ealert(1)%3C%2Fscript%3E&note=hello"
  },
  {
   "id": "evasion:xss-chunked",
   "class": "framing",
   "note": "XSS in a chunked POST without Content-Length (one chunk)",
   "expect": {
    "balanced": "block",
    "strict": "block"
   },
   "method": "POST",
   "headers": {
    "Content-Type": "application/x-www-form-urlencoded",
    "User-Agent": "CDNFoundry-WAF-Baseline/1.0"
   },
   "body": "q=%3Cscript%3Ealert(1)%3C%2Fscript%3E&note=hello",
   "transport": "chunked"
  },
  {
   "id": "evasion:xss-chunked-small",
   "class": "framing",
   "note": "XSS split over many 3-byte chunks",
   "method": "POST",
   "headers": {
    "Content-Type": "application/x-www-form-urlencoded",
    "User-Agent": "CDNFoundry-WAF-Baseline/1.0"
   },
   "body": "q=%3Cscript%3Ealert(1)%3C%2Fscript%3E&note=hello",
   "transport": "chunked",
   "chunk_size": 3
  },
  {
   "id": "evasion:xss-chunked-json",
   "class": "framing",
   "note": "XSS in a chunked JSON body",
   "expect": {
    "balanced": "block",
    "strict": "block"
   },
   "method": "POST",
   "headers": {
    "Content-Type": "application/json",
    "User-Agent": "CDNFoundry-WAF-Baseline/1.0"
   },
   "body": "{\"q\": \"<script>alert(1)</script>\"}",
   "transport": "chunked"
  },
  {
   "id": "evasion:xss-chunked-multipart",
   "class": "framing",
   "note": "XSS in a chunked multipart field",
   "expect": {
    "balanced": "block",
    "strict": "block"
   },
   "method": "POST",
   "headers": {
    "Content-Type": "multipart/form-data; boundary=B",
    "User-Agent": "CDNFoundry-WAF-Baseline/1.0"
   },
   "transport": "chunked",
   "body": "--B\r\nContent-Disposition: form-data; name=\"q\"\r\n\r\n<script>alert(1)</script>\r\n--B--\r\n"
  },
  {
   "id": "evasion:xss-h2",
   "class": "framing",
   "note": "XSS in an HTTP/2 POST over TLS without Content-Length",
   "expect": {
    "balanced": "block",
    "strict": "block"
   },
   "method": "POST",
   "headers": {
    "Content-Type": "application/x-www-form-urlencoded",
    "User-Agent": "CDNFoundry-WAF-Baseline/1.0"
   },
   "body": "q=%3Cscript%3Ealert(1)%3C%2Fscript%3E&note=hello",
   "transport": "h2"
  },
  {
   "id": "evasion:xss-h2c",
   "class": "framing",
   "note": "XSS in a cleartext HTTP/2 POST without Content-Length",
   "expect": {
    "balanced": "block",
    "strict": "block"
   },
   "method": "POST",
   "headers": {
    "Content-Type": "application/x-www-form-urlencoded",
    "User-Agent": "CDNFoundry-WAF-Baseline/1.0"
   },
   "body": "q=%3Cscript%3Ealert(1)%3C%2Fscript%3E&note=hello",
   "transport": "h2c"
  },
  {
   "id": "evasion:sqli-chunked",
   "class": "framing",
   "note": "SQL injection in a chunked POST",
   "expect": {
    "balanced": "block",
    "strict": "block"
   },
   "method": "POST",
   "headers": {
    "Content-Type": "application/x-www-form-urlencoded",
    "User-Agent": "CDNFoundry-WAF-Baseline/1.0"
   },
   "body": "id=1%27%20UNION%20SELECT%20username%2Cpassword%20FROM%20users--%20-",
   "transport": "chunked"
  },
  {
   "id": "evasion:sqli-h2",
   "class": "framing",
   "note": "SQL injection in an HTTP/2 POST without Content-Length",
   "expect": {
    "balanced": "block",
    "strict": "block"
   },
   "method": "POST",
   "headers": {
    "Content-Type": "application/x-www-form-urlencoded",
    "User-Agent": "CDNFoundry-WAF-Baseline/1.0"
   },
   "body": "id=1%27%20UNION%20SELECT%20username%2Cpassword%20FROM%20users--%20-",
   "transport": "h2"
  },
  {
   "id": "evasion:benign-chunked",
   "class": "framing-clean",
   "note": "A clean chunked POST must pass",
   "expect": {
    "balanced": "pass",
    "strict": "pass"
   },
   "method": "POST",
   "headers": {
    "Content-Type": "application/x-www-form-urlencoded",
    "User-Agent": "CDNFoundry-WAF-Baseline/1.0"
   },
   "body": "name=alice&city=Tehran&note=hello+world",
   "transport": "chunked"
  },
  {
   "id": "evasion:benign-h2",
   "class": "framing-clean",
   "note": "A clean HTTP/2 POST without Content-Length must pass",
   "expect": {
    "balanced": "pass",
    "strict": "pass"
   },
   "method": "POST",
   "headers": {
    "Content-Type": "application/x-www-form-urlencoded",
    "User-Agent": "CDNFoundry-WAF-Baseline/1.0"
   },
   "body": "name=alice&city=Tehran&note=hello+world",
   "transport": "h2"
  },
  {
   "id": "evasion:xss-double-url-encoded",
   "class": "encoding",
   "note": "Double URL-encoded script tag in the query",
   "path": "/?q=%253Cscript%253Ealert(1)%253C/script%253E",
   "headers": {
    "User-Agent": "CDNFoundry-WAF-Baseline/1.0"
   }
  },
  {
   "id": "evasion:xss-percent-u",
   "class": "encoding",
   "note": "IIS-style %u encoding of a script tag",
   "path": "/?q=%u003Cscript%u003Ealert(1)%u003C/script%u003E",
   "headers": {
    "User-Agent": "CDNFoundry-WAF-Baseline/1.0"
   }
  },
  {
   "id": "evasion:xss-mixed-case",
   "class": "encoding",
   "note": "Mixed-case script tag",
   "expect": {
    "balanced": "block",
    "strict": "block"
   },
   "path": "/?q=%3CScRiPt%3Ealert(1)%3C/sCrIpT%3E",
   "headers": {
    "User-Agent": "CDNFoundry-WAF-Baseline/1.0"
   }
  },
  {
   "id": "evasion:xss-html-entities",
   "class": "encoding",
   "note": "HTML-entity encoded handler attribute",
   "path": "/?q=%3Cimg%20src%3Dx%20onerror%3D%26%2397%3Blert(1)%3E",
   "headers": {
    "User-Agent": "CDNFoundry-WAF-Baseline/1.0"
   }
  },
  {
   "id": "evasion:xss-null-byte",
   "class": "encoding",
   "note": "Null byte inside the tag name",
   "path": "/?q=%3Cscr%00ipt%3Ealert(1)%3C/script%3E",
   "headers": {
    "User-Agent": "CDNFoundry-WAF-Baseline/1.0"
   }
  },
  {
   "id": "evasion:xss-utf7",
   "class": "encoding",
   "note": "UTF-7 encoded script tag with a UTF-7 charset",
   "method": "POST",
   "headers": {
    "Content-Type": "application/x-www-form-urlencoded; charset=utf-7",
    "User-Agent": "CDNFoundry-WAF-Baseline/1.0"
   },
   "body": "q=%2BADw-script%2BAD4-alert(1)%2BADw-/script%2BAD4-"
  },
  {
   "id": "evasion:xss-gzip-body",
   "class": "encoding",
   "note": "XSS in a gzip Content-Encoding body the WAF cannot read",
   "method": "POST",
   "headers": {
    "Content-Type": "application/x-www-form-urlencoded",
    "Content-Encoding": "gzip",
    "User-Agent": "CDNFoundry-WAF-Baseline/1.0"
   },
   "body_base64": "H4sIAAAAAAACAyu0VTV2Lk4uyiwoUTV2TcxJLSrRMNQEiqkaucGF1fLyS1JtM1JzcvIBgBV7FzAAAAA="
  },
  {
   "id": "evasion:sqli-comment-split",
   "class": "encoding",
   "note": "UNION SELECT split by inline comments",
   "path": "/?id=1%27%20UN/**/ION%20SEL/**/ECT%20password%20FROM%20users--%20-",
   "headers": {
    "User-Agent": "CDNFoundry-WAF-Baseline/1.0"
   }
  },
  {
   "id": "evasion:sqli-newline-space",
   "class": "encoding",
   "note": "UNION SELECT separated by newlines",
   "path": "/?id=1%27%0aUNION%0aSELECT%0apassword%0aFROM%0ausers--%20-",
   "headers": {
    "User-Agent": "CDNFoundry-WAF-Baseline/1.0"
   }
  },
  {
   "id": "evasion:sqli-fullwidth",
   "class": "encoding",
   "note": "Full-width Unicode quote and keywords",
   "path": "/?id=1%EF%BC%87%20OR%20%EF%BC%871%EF%BC%87%3D%EF%BC%871",
