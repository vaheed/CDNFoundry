<clickhouse>
  <!-- ClickHouse's own diagnostic logs grew to 3 GB beside 32 MB of telemetry in eight days and kept the
       server near one busy core. Prometheus reads the metrics endpoint, not these tables, so the high-volume
       logs are off and the rest expire. -->
  <text_log remove="1"/>
  <trace_log remove="1"/>
  <processors_profile_log remove="1"/>
  <asynchronous_metric_log remove="1"/>
  <metric_log remove="1"/>
  <part_log remove="1"/>
  <query_views_log remove="1"/>
  <!-- Added by newer ClickHouse releases and on by default: one row per background task, with no expiry. -->
  <background_schedule_pool_log remove="1"/>
  <query_log>
    <database>system</database>
    <table>query_log</table>
    <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    <flush_interval_milliseconds>15000</flush_interval_milliseconds>
  </query_log>
  <!-- On by default with no expiry. Kept for diagnosis, but only for as long as the query log. -->
  <error_log>
    <database>system</database>
    <table>error_log</table>
    <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
  </error_log>
  <query_metric_log>
    <database>system</database>
    <table>query_metric_log</table>
    <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
  </query_metric_log>
</clickhouse>
