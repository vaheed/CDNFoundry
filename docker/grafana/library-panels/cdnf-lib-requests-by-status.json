{
  "model": {
    "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
    },
    "description": "Requests per second across the selected PoPs, split by response class.",
    "fieldConfig": {
      "defaults": {
        "color": {
          "mode": "palette-classic"
        },
        "custom": {
          "drawStyle": "line",
          "fillOpacity": 12,
          "lineWidth": 1,
          "showPoints": "never",
          "spanNulls": true,
          "stacking": {
            "group": "A",
            "mode": "normal"
          },
          "thresholdsStyle": {
            "mode": "off"
          }
        },
        "mappings": [
          {
            "options": {
              "match": "null+nan",
              "result": {
                "color": "text",
                "text": "No data yet"
              }
            },
            "type": "special"
          }
        ],
        "noValue": "No traffic",
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {
              "color": "text",
              "value": null
            }
          ]
        },
        "unit": "reqps"
      },
      "overrides": []
    },
    "options": {
      "legend": {
        "calcs": [],
        "displayMode": "list",
        "placement": "bottom",
        "showLegend": true
      },
      "tooltip": {
        "mode": "multi",
        "sort": "desc"
      }
    },
    "targets": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "expr": "sum by (status_class) (cdnf:edge_requests:rate5m{region=~\"$region\",pop=~\"$pop\",edge=~\"$edge\"})",
        "instant": false,
        "legendFormat": "{{status_class}}",
        "range": true,
        "refId": "A"
      }
    ],
    "title": "Requests by status class",
    "type": "timeseries"
  },
  "name": "Requests by status class",
  "uid": "cdnf-lib-requests-by-status"
}
