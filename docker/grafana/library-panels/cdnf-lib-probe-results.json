{
  "model": {
    "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
    },
    "description": "The latest result of every synthetic probe, per PoP and IP version. 1 is up, 0 is down.",
    "fieldConfig": {
      "defaults": {
        "color": {
          "mode": "thresholds"
        },
        "custom": {
          "align": "auto",
          "cellOptions": {
            "type": "auto"
          },
          "inspect": false
        },
        "mappings": [],
        "noValue": "\u2013",
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {
              "color": "text",
              "value": null
            }
          ]
        },
        "unit": "short"
      },
      "overrides": [
        {
          "matcher": {
            "id": "byRegexp",
            "options": "^(.*_id|rule|domain|asn|id)$"
          },
          "properties": [
            {
              "id": "unit",
              "value": "none"
            },
            {
              "id": "decimals",
              "value": 0
            }
          ]
        },
        {
          "matcher": {
            "id": "byName",
            "options": "IP"
          },
          "properties": [
            {
              "id": "custom.width",
              "value": 60
            },
            {
              "id": "mappings",
              "value": [
                {
                  "options": {
                    "4": {
                      "text": "IPv4"
                    },
                    "6": {
                      "text": "IPv6"
                    }
                  },
                  "type": "value"
                }
              ]
            }
          ]
        },
        {
          "matcher": {
            "id": "byName",
            "options": "Up"
          },
          "properties": [
            {
              "id": "custom.width",
              "value": 60
            },
            {
              "id": "thresholds",
              "value": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "red",
                    "value": null
                  },
                  {
                    "color": "green",
                    "value": 1
                  }
                ]
              }
            },
            {
              "id": "custom.cellOptions",
              "value": {
                "type": "color-background"
              }
            }
          ]
        },
        {
          "matcher": {
            "id": "byName",
            "options": "PoP"
          },
          "properties": [
            {
              "id": "links",
              "value": [
                {
                  "title": "Open PoP detail",
                  "url": "/d/cdnf-pop-detail?var-pop=${__value.raw}"
                }
              ]
            }
          ]
        }
      ]
    },
    "options": {
      "cellHeight": "sm",
      "footer": {
        "show": false
      },
      "showHeader": true,
      "sortBy": [
        {
          "desc": true,
          "displayName": "Value"
        }
      ]
    },
    "targets": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "expr": "probe_success{job=~\"blackbox-.*\"}",
        "format": "table",
        "instant": true,
        "legendFormat": "probe",
        "range": false,
        "refId": "A"
      }
    ],
    "title": "Probe results",
    "transformations": [
      {
        "id": "organize",
        "options": {
          "excludeByName": {
            "Time": true,
            "__name__": true,
            "instance": true,
            "node": true,
            "probe": true
          },
          "indexByName": {
            "IP": 3,
            "PoP": 1,
            "Probe": 2,
            "Region": 4,
            "Up": 0
          },
          "renameByName": {
            "Value": "Up",
            "ip_version": "IP",
            "job": "Probe",
            "pop": "PoP",
            "region": "Region"
          }
        }
      }
    ],
    "type": "table"
  },
  "name": "Probe results",
  "uid": "cdnf-lib-probe-results"
}
