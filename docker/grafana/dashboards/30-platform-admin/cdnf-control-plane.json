      "description": "Components reporting degraded or unavailable.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "match": "null+nan",
                "result": {
                  "color": "text",
                  "text": "No data yet"
