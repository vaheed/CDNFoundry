      },
      {
        "datasource": {
          "type": "postgres",
          "uid": "control-db"
        },
        "enable": true,
        "iconColor": "blue",
        "name": "Fleet rollouts",
        "target": {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT created_at AS time, 'Fleet rollout ' || status AS text, 'rollout' AS tags FROM grafana_fleet_rollouts WHERE $__timeFilter(created_at) ORDER BY created_at LIMIT 200",
          "refId": "Anno"
        }
      },
      {
        "datasource": {
          "type": "postgres",
          "uid": "control-db"
        },
        "enable": true,
        "iconColor": "purple",
        "name": "Artifact publishes",
        "target": {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('minute', created_at) AS time, 'Edge artifact published: ' || kind AS text, 'artifact' AS tags FROM grafana_edge_artifacts WHERE $__timeFilter(created_at) GROUP BY 1, kind ORDER BY 1 LIMIT 200",
          "refId": "Anno"
        }
      },
      {
        "datasource": {
          "type": "postgres",
          "uid": "control-db"
        },
        "enable": true,
        "iconColor": "orange",
        "name": "Purges",
        "target": {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT created_at AS time, 'Cache purge ' || type AS text, 'purge' AS tags FROM grafana_cache_purges WHERE $__timeFilter(created_at) ORDER BY created_at LIMIT 200",
          "refId": "Anno"
        }
      },
      {
        "datasource": {
          "type": "postgres",
          "uid": "control-db"
        },
        "enable": true,
        "iconColor": "yellow",
        "name": "Settings changes",
        "target": {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT created_at AS time, action AS text, 'settings' AS tags FROM grafana_audit_events WHERE $__timeFilter(created_at) AND (action LIKE 'settings.%' OR action LIKE 'platform.%') ORDER BY created_at LIMIT 200",
          "refId": "Anno"
        }
      },
      {
        "datasource": {
          "type": "postgres",
          "uid": "control-db"
        },
        "enable": true,
        "iconColor": "red",
        "name": "Emergency mode",
        "target": {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT created_at AS time, 'Emergency mode on for ' || target_type AS text, 'emergency' AS tags FROM grafana_emergency_modes WHERE $__timeFilter(created_at) ORDER BY created_at LIMIT 200",
          "refId": "Anno"
        }
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "expr": "ALERTS{alertstate=\"firing\",severity=\"critical\"}",
        "iconColor": "dark-red",
        "name": "Critical alerts",
        "step": "60s",
        "tagKeys": "team,alertname",
        "textFormat": "{{summary}}",
        "titleFormat": "{{alertname}}"
      }
    ]
  },
