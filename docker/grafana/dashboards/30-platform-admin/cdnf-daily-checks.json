      "title": "Runbook",
      "type": "link",
      "url": "https://vaheed.github.io/CDNFoundry/operations/runbooks#component-unhealthy"
    }
  ],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Every daily check as pass or fail. A red tile is a failed check; open its runbook from the Now dashboard.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "text": "fail"
                },
                "1": {
                  "color": "green",
                  "text": "pass"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "match": "null+nan",
                "result": {
                  "color": "text",
                  "text": "No data yet"
                }
              },
              "type": "special"
            }
          ],
          "noValue": "No traffic",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {
          "titleSize": 14,
          "valueSize": 22
        },
        "textMode": "value",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(max(cdnfoundry_edge_gateway_active_revision) - min(cdnfoundry_edge_gateway_active_revision) <= bool 5) or vector(0)",
          "instant": true,
          "legendFormat": "PoPs hold the latest artifact",
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(cdnfoundry_dns_deployments_drifted == bool 0)",
          "instant": true,
          "legendFormat": "DNS serials match desired",
          "range": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(cdnfoundry_pool_dns_fail_static) == bool 0)",
          "instant": true,
          "legendFormat": "No pool address set shrank",
          "range": false,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(min(cdnfoundry_edge_identity_expires_seconds) > bool 30 * 86400) or vector(1)",
          "instant": true,
          "legendFormat": "No edge identity near expiry",
          "range": false,
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "cdnfoundry_component_health{component=\"edge_placements\"}",
          "instant": true,
          "legendFormat": "No placement stuck deploying",
          "range": false,
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(max(cdnfoundry_queue_oldest_job_age_seconds) < bool 900) or vector(1)",
          "instant": true,
          "legendFormat": "Queue latency under bound",
          "range": false,
          "refId": "F"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(increase(alertmanager_notifications_total{integration=\"webhook\"}[1h])) > bool 0)",
          "instant": true,
          "legendFormat": "Watchdog delivered within the hour",
          "range": false,
          "refId": "G"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(cdnfoundry_tls_certificates_expiring == bool 0)",
          "instant": true,
          "legendFormat": "No certificate near expiry unrenewed",
          "range": false,
          "refId": "H"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "cdnfoundry_component_health{component=\"backups\"}",
          "instant": true,
          "legendFormat": "Backup fresh and checks pass",
          "range": false,
          "refId": "I"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(increase(vector_component_discarded_events_total{intentional!=\"true\"}[1h])) == bool 0) * (sum(increase(vector_component_errors_total{component_id=~\"clickhouse_.*\"}[1h])) == bool 0)",
          "instant": true,
          "legendFormat": "Vector drops nothing, ClickHouse accepts",
          "range": false,
          "refId": "J"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(cdnfoundry_control_ha_state{state=\"degraded\"} == bool 0) or vector(1)",
          "instant": true,
          "legendFormat": "Control HA state not degraded",
          "range": false,
          "refId": "K"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "((cdnfoundry_control_valkey_replica_linked == bool 1) or vector(1)) * ((cdnfoundry_control_fingerprint_mismatch == bool 0) or vector(1))",
          "instant": true,
          "legendFormat": "Valkey linked, secrets match",
          "range": false,
          "refId": "L"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(cdnfoundry_control_edges_missing_addresses == bool 0)",
          "instant": true,
          "legendFormat": "PoPs hold the control addresses",
          "range": false,
          "refId": "M"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "cdnfoundry_component_health{component=\"control_ha\"}",
          "instant": true,
          "legendFormat": "Services run on the primary node",
          "range": false,
          "refId": "N"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(min(up{job=\"node\",role=\"control\"}) == bool 1) or vector(1)",
          "instant": true,
          "legendFormat": "Standby watched, dead-man alarm delivered",
          "range": false,
          "refId": "O"
        }
      ],
      "title": "Daily checks",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Daily checks that fail now.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "match": "null+nan",
                "result": {
                  "color": "text",
                  "text": "No data yet"
                }
              },
              "type": "special"
            }
          ],
          "noValue": "No traffic",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count((((max(cdnfoundry_edge_gateway_active_revision) - min(cdnfoundry_edge_gateway_active_revision) <= bool 5) or vector(0)) or ((cdnfoundry_dns_deployments_drifted == bool 0)) or ((sum(cdnfoundry_pool_dns_fail_static) == bool 0)) or ((min(cdnfoundry_edge_identity_expires_seconds) > bool 30 * 86400) or vector(1)) or (cdnfoundry_component_health{component=\"edge_placements\"}) or ((max(cdnfoundry_queue_oldest_job_age_seconds) < bool 900) or vector(1)) or ((sum(increase(alertmanager_notifications_total{integration=\"webhook\"}[1h])) > bool 0)) or ((cdnfoundry_tls_certificates_expiring == bool 0)) or (cdnfoundry_component_health{component=\"backups\"}) or ((sum(increase(vector_component_discarded_events_total{intentional!=\"true\"}[1h])) == bool 0) * (sum(increase(vector_component_errors_total{component_id=~\"clickhouse_.*\"}[1h])) == bool 0)) or ((cdnfoundry_control_ha_state{state=\"degraded\"} == bool 0) or vector(1)) or (((cdnfoundry_control_valkey_replica_linked == bool 1) or vector(1)) * ((cdnfoundry_control_fingerprint_mismatch == bool 0) or vector(1))) or ((cdnfoundry_control_edges_missing_addresses == bool 0)) or (cdnfoundry_component_health{component=\"control_ha\"}) or ((min(up{job=\"node\",role=\"control\"}) == bool 1) or vector(1))) == 0) or vector(0)",
          "instant": true,
          "legendFormat": "failing",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Checks failing",
      "type": "stat"
    }
  ],
  "refresh": "30s",
