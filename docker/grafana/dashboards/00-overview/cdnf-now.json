      "id": 20,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pop) (cdnf:edge_requests:rate5m{region=~\"$region\",pop=~\"$pop\",edge=~\"$edge\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "Requests",
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum by (pop) (cdnf:edge_requests:rate5m{region=~\"$region\",pop=~\"$pop\",edge=~\"$edge\",status_class=\"5xx\"}) / sum by (pop) (cdnf:edge_requests:rate5m{region=~\"$region\",pop=~\"$pop\",edge=~\"$edge\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "5xx",
          "range": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (pop) (cdnfoundry_edge_heartbeat_age_seconds{pop=~\"$pop\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "Heartbeat",
          "range": false,
          "refId": "C"
        }
      ],
      "title": "PoPs",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "Requests/s",
              "Value #B": "5xx %",
              "Value #C": "Heartbeat age",
              "pop": "PoP"
            }
          }
        }
      ],
      "type": "table"
    },
