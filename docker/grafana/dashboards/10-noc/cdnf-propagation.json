    {
      "datasource": {
        "type": "postgres",
        "uid": "control-db"
      },
      "description": "Edges that have not applied the newest published artifact, with how many artifacts each is behind.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "noValue": "\u2013",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(.*_id|rule|domain|asn|id)$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "oldest_unapplied_seconds"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "id": 7,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "control-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT e.name AS pop, (SELECT max(sequence) FROM grafana_edge_artifacts a WHERE a.edge_id = e.id) - e.active_sequence AS artifacts_behind, COALESCE(extract(epoch FROM now() - (SELECT min(created_at) FROM grafana_edge_artifacts a WHERE a.edge_id = e.id AND a.sequence > e.active_sequence)), 0)::int AS oldest_unapplied_seconds FROM grafana_edges e WHERE e.enabled = true ORDER BY oldest_unapplied_seconds DESC, artifacts_behind DESC LIMIT 50",
          "refId": "A"
        }
      ],
      "title": "Slowest PoP",
      "type": "table"
    }
