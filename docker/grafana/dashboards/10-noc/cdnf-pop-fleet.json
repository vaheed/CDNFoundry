  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "One row per PoP with health, heartbeat age, applied revision, traffic, errors, latency, host load, and cache fill.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [
            {
              "options": {
                "match": "null+nan",
                "result": {
                  "color": "text",
                  "text": "No data yet"
                }
              },
              "type": "special"
            }
          ],
          "noValue": "No traffic",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Heartbeat age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 120
                    },
                    {
                      "color": "red",
                      "value": 600
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Requests/s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "reqps"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "5xx %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95 ms"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "(CPU|Memory|Disk|Cache fill) %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (pop) (cdnfoundry_edge_heartbeat_age_seconds{pop=~\"$pop\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "Heartbeat",
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (pop) (cdnfoundry_edge_gateway_active_revision{pop=~\"$pop\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "Applied",
          "range": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(cdnfoundry_edge_gateway_active_revision)",
          "format": "table",
          "instant": true,
          "legendFormat": "Latest",
          "range": false,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pop) (cdnf:edge_requests:rate5m{region=~\"$region\",pop=~\"$pop\",edge=~\"$edge\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "Requests",
          "range": false,
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum by (pop) (cdnf:edge_requests:rate5m{region=~\"$region\",pop=~\"$pop\",edge=~\"$edge\",status_class=\"5xx\"}) / sum by (pop) (cdnf:edge_requests:rate5m{region=~\"$region\",pop=~\"$pop\",edge=~\"$edge\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "5xx",
          "range": false,
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1000 * histogram_quantile(0.95, sum by (le, pop) (cdnf:edge_latency_bucket:rate5m{region=~\"$region\",pop=~\"$pop\",edge=~\"$edge\"}))",
          "format": "table",
          "instant": true,
          "legendFormat": "p95",
          "range": false,
          "refId": "F"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(100 * (1 - avg by (node) (rate(node_cpu_seconds_total{mode=\"idle\",role=~\"edge|dns-edge\"}[5m]))), \"pop\", \"$1\", \"node\", \"(.*)\")",
          "format": "table",
          "instant": true,
          "legendFormat": "CPU",
          "range": false,
          "refId": "G"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(100 * (1 - node_memory_MemAvailable_bytes{role=~\"edge|dns-edge\"} / node_memory_MemTotal_bytes{role=~\"edge|dns-edge\"}), \"pop\", \"$1\", \"node\", \"(.*)\")",
          "format": "table",
          "instant": true,
          "legendFormat": "Memory",
          "range": false,
          "refId": "H"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\",role=~\"edge|dns-edge\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\",role=~\"edge|dns-edge\"}), \"pop\", \"$1\", \"node\", \"(.*)\")",
          "format": "table",
          "instant": true,
          "legendFormat": "Disk",
          "range": false,
          "refId": "I"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * max by (pop) (cdnfoundry_cell_capacity_ratio{resource=\"cache\",pop=~\"$pop\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "Cache",
          "range": false,
          "refId": "J"
        }
      ],
      "title": "PoP fleet",
      "transformations": [
