      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT occurred_at AS time, pop, edge_id, hostname, method, path, status, cache_status, request_time_ms, upstream_header_ms, origin_latency_ms, origin_error, origin_role, security_action, security_class, server_protocol, ssl_protocol FROM cdnf.edge_events WHERE request_id = '${request_id}' AND request_id != '' AND occurred_at > now() - INTERVAL 7 DAY ORDER BY occurred_at LIMIT 20",
          "refId": "A"
        }
      ],
      "title": "Edge log",
      "type": "table"
    },
