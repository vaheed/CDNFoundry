          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace({__name__=~\"slo:.*:bad_ratio_rate1h\"}, \"slo\", \"$1\", \"__name__\", \"slo:(.*):bad_ratio_rate1h\") / on(slo) label_replace({__name__=~\"slo:.*:error_budget\"}, \"slo\", \"$1\", \"__name__\", \"slo:(.*):error_budget\")",
          "instant": false,
          "legendFormat": "{{slo}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Burn rate",
      "type": "timeseries"
