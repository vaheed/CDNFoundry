    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Days until the first cache is forecast to fill, by a linear forecast from the last 7 days. Shows \"Not within a year\" when no cache is on course to fill.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "mappings": [
            {
              "options": {
                "match": "null+nan",
                "result": {
                  "color": "text",
                  "text": "No data yet"
                }
              },
              "type": "special"
            },
            {
              "options": {
                "from": 365,
                "result": {
                  "text": "Not within a year"
                },
                "to": 1000000000.0
              },
              "type": "range"
            }
          ],
          "noValue": "\u2013",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "d"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "clamp_max(clamp_min(min(((1 - cdnfoundry_cell_capacity_ratio{resource=\"cache\"}) / clamp_min(deriv(cdnfoundry_cell_capacity_ratio{resource=\"cache\"}[7d]), 1e-12)) / 86400), 0), 365)",
          "instant": true,
          "legendFormat": "days",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "First to run out",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Forecast cache fill in 30 days per PoP and cell. A value at or above 1 means the cache is full by then. The first row runs out first.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "noValue": "\u2013",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(.*_id|rule|domain|asn|id)$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Fill in 30 days"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.7
                    },
                    {
                      "color": "red",
                      "value": 0.9
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 5,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Value"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sort_desc(predict_linear(cdnfoundry_cell_capacity_ratio{resource=\"cache\"}[7d], 30 * 86400))",
          "format": "table",
          "instant": true,
          "legendFormat": "forecast",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Forecast: first PoP to run out",
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "pop",
                "cell",
                "Value"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "Cell": 1,
              "Fill in 30 days": 2,
              "PoP": 0
            },
            "renameByName": {
              "Value": "Fill in 30 days",
              "cell": "Cell",
              "pop": "PoP"
            }
          }
        }
      ],
      "type": "table"
    },
