          "queryType": "table",
          "rawSql": "SELECT if(zone = '', '(outside served zones)', zone) AS zone_name, sum(queries) AS query_count FROM cdnf.dns_hourly WHERE interval_start >= toStartOfHour($__fromTime) AND interval_start <= $__toTime GROUP BY zone_name ORDER BY query_count DESC LIMIT 10",
