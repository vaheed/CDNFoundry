          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT if(position(client_ip, ':') > 0, toString(IPv6CIDRToRange(toIPv6OrZero(client_ip), 48).1) || '/48', toString(IPv4CIDRToRange(toIPv4OrZero(client_ip), 24).1) || '/24') AS network, count() AS queries FROM cdnf.dns_events WHERE $__timeFilter(occurred_at) AND occurred_at > now() - INTERVAL 7 DAY GROUP BY network ORDER BY queries DESC LIMIT 10",
          "refId": "A"
        }
      ],
      "title": "Top client networks",
      "type": "bargauge"
