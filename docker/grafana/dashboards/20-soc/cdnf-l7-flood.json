  "panels": [
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "description": "Each domain's request rate in the last 10 minutes against its average over the previous day. A ratio above 4 is a flood candidate.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [
            {
              "options": {
                "match": "null+nan",
                "result": {
                  "color": "text",
                  "text": "No data yet"
                }
              },
              "type": "special"
            }
          ],
          "noValue": "\u2013",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ratio"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 2
                    },
                    {
                      "color": "red",
                      "value": 4
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "rate_.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "reqps"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT cur.domain_id AS domain, cur.requests / 600 AS rate_now, base.requests / 86400 AS rate_baseline, (cur.requests / 600) / nullIf(base.requests / 86400, 0) AS ratio FROM (SELECT domain_id, sum(requests) AS requests FROM cdnf.edge_traffic_1m WHERE interval_start > now() - INTERVAL 10 MINUTE AND $__conditionalAll(region IN (${region:singlequote}), $region) AND $__conditionalAll(pop IN (${pop:singlequote}), $pop) AND $__conditionalAll(edge_id IN (${edge:singlequote}), $edge) AND $__conditionalAll(domain_id IN (${domain:csv}), $domain) GROUP BY domain_id) AS cur LEFT JOIN (SELECT domain_id, sum(requests) AS requests FROM cdnf.edge_traffic_hourly WHERE interval_start BETWEEN now() - INTERVAL 25 HOUR AND now() - INTERVAL 1 HOUR AND $__conditionalAll(region IN (${region:singlequote}), $region) AND $__conditionalAll(pop IN (${pop:singlequote}), $pop) AND $__conditionalAll(edge_id IN (${edge:singlequote}), $edge) AND $__conditionalAll(domain_id IN (${domain:csv}), $domain) GROUP BY domain_id) AS base USING domain_id ORDER BY ratio DESC LIMIT 20",
          "refId": "A"
        }
      ],
      "title": "Request rate against baseline",
      "type": "table"
    },
